+            if (scenario.equals("OTHER_AUTOSTART")) harness.peer.enabled.put("web", false);
+            if (scenario.equals("IDENTITY")) harness.peer.current.put("web", "f".repeat(64));
+            if (scenario.equals("MODEL")) harness.modelRevision = "f".repeat(64);

+        boolean disable = scenario.startsWith("DISABLE_");
+        harness.peer.lossVerb = start ? "start" : disable ? "disable" : "stop";
+        harness.peer.lossUnit = disable && !scenario.equals("DISABLE_PARTIAL_ACK") ? "web" : "worker";

+    process = subprocess.Popen(["/bin/bash", "--noprofile", "--norc", "-p", "-s", "--", *args],
+        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True,
+        env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C", "LC_ALL": "C"})
+    sent = 0

+        started = b"CONTINUATION_MUTATION_STARTED=1\n" in text
+        if process.returncode == 0 and not errors and text == b"CONTINUATION_MUTATION_STARTED=1\nROLLED_BACK=1\nCONTINUATION_COMPLETED=1\n":

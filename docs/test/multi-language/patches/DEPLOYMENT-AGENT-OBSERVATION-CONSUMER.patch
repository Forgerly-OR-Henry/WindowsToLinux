+                        Duration timeout = changed.equals("TIMEOUT_HIGH") ? Duration.ofSeconds(31) : changed.equals("TIMEOUT_ZERO") ? Duration.ZERO : changed.equals("TIMEOUT_NANOS") ? Duration.ofSeconds(29).plusNanos(1) : Duration.ofSeconds(30);

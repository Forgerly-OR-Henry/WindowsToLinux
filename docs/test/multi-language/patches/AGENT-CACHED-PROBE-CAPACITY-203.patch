diff --git a/src/mod/deployment/src/main/resources/gold/debug/windowstolinux/mod/deployment/service/agent/toolchain/installed-controller-review.md b/src/mod/deployment/src/main/resources/gold/debug/windowstolinux/mod/deployment/service/agent/toolchain/installed-controller-review.md

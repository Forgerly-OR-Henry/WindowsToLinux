+    private Map<String, List<List<String>>> rawPublicationRows(PlatformRuntime runtime, TaskContext task) throws Exception {
+        var result = new LinkedHashMap<String, List<List<String>>>();
+        try (var connection = runtime.modContexts().get(OWNER).context().db().openConnection(task)) {
+            for (String table : List.of("managed_application", "managed_application_component", "managed_application_dependency",
+                "deployment_unit", "deployment_unit_configuration_snapshot", "deployment_unit_configuration_entry",
+                "deployment_unit_release_binding", "secret_revision", "deployment_unit_release_secret_reference", "deployment_release")) {
+                var keys = new TreeMap<Short, String>();
+                try (var primary = connection.getMetaData().getPrimaryKeys(null, connection.getSchema(), table)) {
+                    while (primary.next()) keys.put(primary.getShort("KEY_SEQ"), primary.getString("COLUMN_NAME"));
+                }
+                assertFalse(keys.isEmpty(), table);
+                var contents = new ArrayList<List<String>>();
+                try (var query = connection.createStatement(); var rows = query.executeQuery("SELECT * FROM " + table + " ORDER BY " + String.join(",", keys.values()))) {
+                    while (rows.next()) {
+                        var values = new ArrayList<String>();
+                        for (int index = 1; index <= rows.getMetaData().getColumnCount(); index++) {
+                            if (rows.getObject(index) == null) values.add("null");
+                            else if (Set.of(Types.BLOB, Types.BINARY, Types.VARBINARY).contains(rows.getMetaData().getColumnType(index)))
+                                values.add("binary:" + Base64.getEncoder().encodeToString(rows.getBytes(index)));
+                            else values.add("value:" + rows.getString(index));
+                        }
+                        contents.add(List.copyOf(values));
+                    }
+                }
+                result.put(table, List.copyOf(contents));
+            }
+        }
+        return Map.copyOf(result);
+    }
 }

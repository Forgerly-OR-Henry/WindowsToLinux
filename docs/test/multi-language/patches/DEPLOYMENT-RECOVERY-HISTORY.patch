+        }
+        try {
+            if (created) {
+                var events = journal.events(task);
+                if (gold.debug.windowstolinux.mod.deployment.linux.command.DeploymentModelCommandRunner.unconfirmed(context, task)
+                    || !DeploymentAgentActionLog.effectsSettled(events)

+                    && events.stream().noneMatch(event -> event.type().equals("DELIVERY_RESULT")))
+                    outcome = TaskResult.UNKNOWN;
+                journal.state(task, switch (outcome) {
+                    case SUCCEEDED -> "SUCCEEDED";
+                    case FAILED -> "FAILED";
+                    case CANCELLED -> "CANCELLED";
+                    case UNKNOWN -> "UNKNOWN";

+    public enum FileRole {DEPLOYER, AGENT_TASK, WORKSPACE_DEVICE, WORKSPACE_LIMIT, PURPOSE, WORKSPACE_IMAGE, AGENT_MODE, SOURCE_ARCHIVE}

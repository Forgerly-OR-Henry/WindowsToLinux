+    private static <T> T proxy(Class<T> type, Invocation invoke) {
+        return type.cast(Proxy.newProxyInstance(type.getClassLoader(), new Class<?>[]{type}, (self, method, args) -> invoke.run(method.getName(), args)));
+    }

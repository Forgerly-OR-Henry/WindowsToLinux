+            if (events.stream().anyMatch(value -> value.id() > prepare.id() && value.id() < event.id() && value.action().equals(prepare.action())
+                && Set.of("PREPARE_EXECUTING", "PREPARE_RESULT", "PREPARE_NOT_SENT", EVENT).contains(value.type())))
+                return false;

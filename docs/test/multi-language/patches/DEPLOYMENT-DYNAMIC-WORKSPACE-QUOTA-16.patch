+            var source = prefix.stream().filter(value -> value.type().equals("SOURCE")).reduce((first, last) -> last).orElseThrow();
+            var plan = prefix.stream().filter(value -> value.type().equals("PLAN")).reduce((first, last) -> last).orElseThrow();

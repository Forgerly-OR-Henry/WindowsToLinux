+    @Test
+    void exactAbsentObservationSettlesFailedOriginalArchivesAndDoesNotDispatchAgain() throws Exception {
+        try (var frame = new Frame()) {
+            var business = frame.business();
+            var original = frame.journal.events(frame.task);

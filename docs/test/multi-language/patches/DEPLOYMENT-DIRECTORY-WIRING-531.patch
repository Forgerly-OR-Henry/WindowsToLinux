+    @Test
+    void integrityGuardRejectsAnotherLayoutAndKeepsTheCompleteInvocation() {
+        var first = custom("A");
+        var second = custom("B");
+        String body = "'" + first.helperPath() + "' probe";
+        String guarded = DeploymentManagedHelperBundle.verifiedCommand(body, first);

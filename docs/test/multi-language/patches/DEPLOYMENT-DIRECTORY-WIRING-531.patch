+            wtl_layout_unit='%s'
+            wtl_layout_directory() {
+                [ -d "$1" ] && [ ! -L "$1" ] || return 1
+                [ "$(/usr/bin/stat -c '%%u:%%g' -- "$1")" = 0:0 ] || return 1

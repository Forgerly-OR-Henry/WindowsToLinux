+                decisions.incrementAndGet();
+                System.out.println("USER_AUTHORIZED_DIAGNOSTIC_ACTION task=" + taskId + " type=" + type);
+                return new DeploymentReviewDecision("APPROVE", true, REASON);
+            }
+        };
+    }

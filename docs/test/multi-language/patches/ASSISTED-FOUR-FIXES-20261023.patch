+
+func (c *uploadLogCapture) Write(p []byte) (int, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.raw.Write(p)
+	if start := bytes.Index(p, []byte("FILE_TRANSFER_UPLOAD_DIAGNOSTIC ")); start >= 0 {

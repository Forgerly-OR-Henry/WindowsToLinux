+func uploadWait(t *testing.T, c *uploadLogCapture, stage string) map[string]any {
+	t.Helper()
+	deadline := time.NewTimer(3 * time.Second)
+	defer deadline.Stop()
+	for {
+		for _, line := range c.snapshot() {
+			if line["stage"] == stage {
+				return line
+			}
+		}
+		select {
+		case <-c.wake:
+		case <-deadline.C:

+        });
+    }
+
+    @FunctionalInterface
+    private interface Execution {
+        OperationResult<CommandResult> run(CommandRequest request, ApprovalGrant grant) throws Exception;
+    }
+
+    @FunctionalInterface
+    private interface Closing {
+        void run() throws ApiException;
+    }
+}

+    private String renderSource() {
+        return """
+            import json
+            import os
+            import re
+            import subprocess
+            import sys
+            BASH_SOURCE = %s
+            if __name__ == '__main__':
+                try:
+                    args = sys.argv[1:]
+                    if (len(args) != 8 or os.geteuid() != 0
+                        or any(key in ('BASH_ENV', 'ENV') or key.startswith('BASH_FUNC_') for key in os.environ)):

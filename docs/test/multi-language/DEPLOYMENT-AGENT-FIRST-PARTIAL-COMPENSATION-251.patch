+                && before.stream().noneMatch(e -> e.type().equals(DELIVERY_SETTLED) || e.type().equals(DeploymentAgentActionLog.DELIVERY_RECOVERY_SETTLED) || e.type().equals("DELIVERY_RESULT"));

+                    "reviewRevision", "decision", "reason", "requiresUserConfirmation", "rememberAuthorization", "grant", "semanticOperation", "targets", "actionId"));
+                require(pending == null && completed < steps(plan).size() && text(node, "kind").equals("INTENT")

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{js,mjs,ts,vue,json,yaml,yml,html,css,xml}]
indent_size = 2

[*.{java,kt,kts,py}]
indent_size = 4
max_line_length = 120

[*.go]
indent_style = tab
indent_size = tab

[{Makefile,*.mk}]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false

[*.{rb,ru}]
indent_size = 2

[*.{properties,sql,toml,gradle}]
trim_trailing_whitespace = false

[Gemfile]
indent_size = 2

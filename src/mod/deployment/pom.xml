<?xml version="1.0" encoding="UTF-8" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>gold.debug.windowstolinux</groupId>
    <artifactId>wtlmod-author-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../../.mvn/wtlmod-author-parent/pom.xml</relativePath>
  </parent>
  <artifactId>windowstolinux-mod-deployment</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.1</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-appapi</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-app-main</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-app-main</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <type>test-jar</type>
      <classifier>test-support</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <finalName>deployment</finalName>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.44.3</version>
        <configuration>
          <encoding>UTF-8</encoding>
          <lineEndings>UNIX</lineEndings>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <eclipse>
              <version>4.32</version>
              <file>${maven.multiModuleProjectDirectory}/.mvn/formatting/eclipse.xml</file>
            </eclipse>
            <importOrder>
              <order>java,javax,,#</order>
            </importOrder>
            <trimTrailingWhitespace />
            <endWithNewline />
          </java>
        </configuration>
        <executions>
          <execution>
            <id>java-format-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <argLine>
            "-Djava.io.tmpdir=${project.build.directory}" "-Djdk.net.unixdomain.tmpdir=${project.build.directory}"
          </argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

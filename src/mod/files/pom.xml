<?xml version="1.0" encoding="UTF-8" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>gold.debug.windowstolinux</groupId>
    <artifactId>wtlmod-author-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../../.mvn/wtlmod-author-parent/pom.xml</relativePath>
  </parent>
  <artifactId>windowstolinux-mod-files</artifactId>
  <dependencies>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-appapi</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-app-main</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-app-main</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <type>test-jar</type>
      <classifier>test-support</classifier>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <finalName>files</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <argLine>
            "-Djava.io.tmpdir=${project.build.directory}" "-Djdk.net.unixdomain.tmpdir=${project.build.directory}"
          </argLine>
          <classpathDependencyExcludes>
            <classpathDependencyExclude>gold.debug.windowstolinux:windowstolinux-app-*</classpathDependencyExclude>
            <classpathDependencyExclude>gold.debug.windowstolinux:windowstolinux-appapi</classpathDependencyExclude>
          </classpathDependencyExcludes>
          <additionalClasspathElements>
            <additionalClasspathElement>${project.basedir}/../../app/config/target/classes</additionalClasspathElement>
            <additionalClasspathElement>${project.basedir}/../../app/ai/target/classes</additionalClasspathElement>
            <additionalClasspathElement>${project.basedir}/../../app/linux/target/classes</additionalClasspathElement>
            <additionalClasspathElement>${project.basedir}/../../app/file/target/classes</additionalClasspathElement>
            <additionalClasspathElement>${project.basedir}/../../app/mod/target/classes</additionalClasspathElement>
            <additionalClasspathElement>${project.basedir}/../../app/ui/target/classes</additionalClasspathElement>
            <additionalClasspathElement>${project.basedir}/../../app/windows/target/classes</additionalClasspathElement>
            <additionalClasspathElement>${project.basedir}/../../app/db/target/classes</additionalClasspathElement>
            <additionalClasspathElement>${project.basedir}/../../app/secret/target/classes</additionalClasspathElement>
            <additionalClasspathElement>${project.basedir}/../../app/service/target/classes</additionalClasspathElement>
            <additionalClasspathElement>${project.basedir}/../../appapi/target/classes</additionalClasspathElement>
            <additionalClasspathElement>${project.basedir}/../../app/main/target/classes</additionalClasspathElement>
            <additionalClasspathElement>${project.basedir}/../../app/main/target/test-classes
            </additionalClasspathElement>
          </additionalClasspathElements>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

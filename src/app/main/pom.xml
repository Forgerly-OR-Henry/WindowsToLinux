<?xml version="1.0" encoding="UTF-8" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>gold.debug.windowstolinux</groupId>
    <artifactId>windowstolinux-app</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>windowstolinux-app-main</artifactId>
  <dependencies>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-appapi</artifactId>
      <version>1.0.0-dev.1</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-app-mod</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-shared-standard-deploy</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-shared-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-app-ui</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-app-windows</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-app-db</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-app-secret</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-app-service</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-shared-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-shared-git</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-shared-standard-analyze</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-shared-ai</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-shared-config</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-shared-linux</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-shared-linux-sshd</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-shared-deploy</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>gold.debug.windowstolinux</groupId>
      <artifactId>windowstolinux-shared-backup</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test-only classpath for repository-wide attributed source checks. -->
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.build.api.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
      <version>4.1.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
      <version>3.5.17</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>3.1.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>gold/debug/windowstolinux/app/main/build.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>gold/debug/windowstolinux/app/main/build.properties</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-support-jar</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>test-jar</goal>
            </goals>
            <configuration>
              <classifier>test-support</classifier>
              <includes>
                <include>gold/debug/windowstolinux/app/main/startup/LoopbackSshServer*.class</include>
                <include>gold/debug/windowstolinux/app/main/startup/BackgroundExceptionScope*.class</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>
            "-Djava.io.tmpdir=${project.build.directory}" "-Djdk.net.unixdomain.tmpdir=${project.build.directory}"
          </argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
